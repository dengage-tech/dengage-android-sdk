<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dengage_page_margin_medium"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRequestLocationPermission"
            android:layout_width="match_parent"
            android:layout_height="@dimen/base_component_height"
            android:layout_marginTop="12dp"
            android:text="@string/button_request_location_permission" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStopGeofencing"
            android:layout_width="match_parent"
            android:layout_height="@dimen/base_component_height"
            android:layout_marginTop="12dp"
            android:text="@string/button_stop_geofencing" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLastSilentPushSync"
            android:layout_width="match_parent"
            android:layout_height="@dimen/base_component_height"
            android:layout_marginTop="12dp"
            android:text="@string/button_last_silent_push_sync" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/txtLastSilentPushSync"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_last_silent_push_sync_none" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMonitoredGeofences"
            android:layout_width="match_parent"
            android:layout_height="@dimen/base_component_height"
            android:layout_marginTop="12dp"
            android:text="@string/button_monitored_geofences" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTriggeredEvents"
            android:layout_width="match_parent"
            android:layout_height="@dimen/base_component_height"
            android:layout_marginTop="12dp"
            android:text="@string/button_triggered_events" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/txtGeofenceDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textIsSelectable="true" />

    </LinearLayout>

    </ScrollView>

</layout>